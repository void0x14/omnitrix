{
  "$schema": "https://opencode.ai/config.json",
  "model": "echo-local/echo-sinamalar-aligned-v5-Q4_K_M",
  "small_model": "echo-local/echo-sinamalar-aligned-v5-Q4_K_M",
  "provider": {
    "echo-identity-archive": {
      "name": "Echo Ulaç — Kimlik Arşivi",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "apiKey": "local",
        "baseURL": "http://127.0.0.1:8084/v1"
      },
      "models": {
        "echo-ulac-kisisel-cekirdek-800m-b300-nvfp4-tam-parametre": {
          "id": "echo-ulac-kisisel-cekirdek-800m-b300-nvfp4-tam-parametre",
          "name": "Echo Ulaç — Kişisel Çekirdek — 800M / B300 NVFP4 / Tam Parametre",
          "attachment": false,
          "reasoning": true,
          "temperature": false,
          "tool_call": true,
          "limit": {
            "context": 16384,
            "output": 4096
          },
          "options": {
            "systemMessageMode": "single"
          }
        }
      }
    },
    "echo-readback-archive": {
      "name": "Echo Ulaç — Okuma Sonrası Arşivi",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "apiKey": "local",
        "baseURL": "http://127.0.0.1:8087/v1"
      },
      "models": {
        "echo-ulac-okuma-sonrasi-tamamlama-800m-b300-nvfp4-tam-parametre": {
          "id": "echo-ulac-okuma-sonrasi-tamamlama-800m-b300-nvfp4-tam-parametre",
          "name": "Echo Ulaç — Okuma Sonrası Tamamlama — 800M / B300 NVFP4 / Tam Parametre",
          "attachment": false,
          "reasoning": true,
          "temperature": false,
          "tool_call": true,
          "limit": {
            "context": 16384,
            "output": 4096
          },
          "options": {
            "systemMessageMode": "single"
          }
        }
      }
    },
    "echo-local": {
      "name": "Echo Ulaç — Kişisel Çekirdek",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "apiKey": "local",
        "baseURL": "http://127.0.0.1:8305/v1"
      },
      "models": {
        "echo-sinamalar-aligned-v5-Q4_K_M": {
          "id": "echo-sinamalar-aligned-v5-Q4_K_M",
          "name": "Echo Ulaç — echo-sinamalar-aligned-v5-Q4_K_M",
          "attachment": false,
          "reasoning": true,
          "temperature": false,
          "tool_call": true,
          "limit": {
            "context": 245760,
            "output": 4096
          },
          "options": {
            "systemMessageMode": "single"
          }
        }
      }
    }
  },
  "permission": {
    "read": "allow"
  },
  "references": {
    "effect": {
      "repository": "github.com/Effect-TS/effect-smol",
      "description": "Use for Effect v4 and effect-smol implementation details",
    },
    "opencode-local": {
      "path": "~/.local/share/opencode",
      "description": "Contains opencode logs and data",
    },
  },
  "mcp": {
    "bug-bounty-mcp": { "enabled": true },
    "chrome-devtools": { "enabled": true },
    "codebase-memory-mcp": { "enabled": true },
    "context7": { "enabled": true },
    "exa": { "enabled": true },
    "ffs": { "enabled": true },
    "filesystem": { "enabled": true },
    "firecrawl": { "enabled": true },
    "hashline": { "enabled": true },
    "in-memoria": { "enabled": false },
    "kahin": { "enabled": true },
    "linkup": { "enabled": true },
    "paper-search-mcp": { "enabled": true },
    "pentest-mcp": { "enabled": true },
    "semble": { "enabled": true },
    "sequential-thinking": { "enabled": true },
    "tavily": { "enabled": true }
  },
  "tools": {
    "github-triage": false,
    "github-pr-search": false,
  },
}
